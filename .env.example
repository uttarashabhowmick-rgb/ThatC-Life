# Copy to .env and fill in ONE provider. With no key, ThatC Life uses its built-in planner and still works for any task.
# (Node loads .env automatically via `npm start`.)

# Amazon Bedrock (recommended for this hackathon — counts as AWS usage). Create a Bedrock API key in the AWS console.
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION=us-east-1
# THATC_BEDROCK_MODEL=us.amazon.nova-pro-v1:0

# …or the Anthropic API
# ANTHROPIC_API_KEY=
# THATC_MODEL=claude-sonnet-5-5

# Optional: protect the MCP endpoint with a bearer token
# MCP_AUTH_TOKEN=
